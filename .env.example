# Zava Storefront — Environment Variables
# Copy this file to .env and fill in your values.

# JWT signing secret — REQUIRED in production, uses a dev-only default locally
JWT_SECRET=change-me-in-production

# Server port (default: 3001)
PORT=3001

# CORS allowed origins — comma-separated (default: all origins)
# Example: https://zava.example.com,https://staging.zava.example.com
CORS_ORIGIN=

# PostgreSQL connection string — only needed for Docker / production
# Local dev uses SQLite automatically (no DATABASE_URL needed)
DATABASE_URL=postgresql://zava:password@localhost:5432/zava

# SMTP email settings — required to send review approval notifications
# Leave SMTP_HOST empty to disable email sending (emails will be logged instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@zava.com
